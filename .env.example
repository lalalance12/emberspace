# ---------------------------------------------------------------------------
# Workspace environment
#
# Easiest: add Neon to the Vercel project (Storage -> Create -> Neon), add
# BETTER_AUTH_SECRET in Vercel (Settings -> Environment Variables), then
#   vercel env pull .env.local
#
# Or copy this file to .env.local and fill it in by hand. .env.local is
# gitignored; never commit it.
# ---------------------------------------------------------------------------

# Neon connection string. Server-only: never prefix it with NEXT_PUBLIC_.
# The app connects as the database owner and steps down into the
# `authenticated` role for every user request, so RLS still decides what each
# person can see (lib/db.ts, withUser).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Signs session cookies. Server-only, at least 32 random characters, different
# per environment. Make one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical origin for this deployment. Better Auth falls back to it when a
# request arrives on a host it does not recognise.
#
#   local        leave blank (falls back to http://localhost:3000)
#   Vercel prod  https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=
